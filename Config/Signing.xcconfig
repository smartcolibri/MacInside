// Shared signing settings, inherited by every target (app, widget extension,
// tests). Wired as the project-level `configFiles` in project.yml. Values set
// under `settings` in project.yml would override this file, so
// DEVELOPMENT_TEAM lives only here.
//
// Contributors: copy Local.xcconfig.example to Local.xcconfig at the repo root
// to sign with your own team. Local.xcconfig is git-ignored and optional.

DEVELOPMENT_TEAM = KFLACS69T9

#include? "../Local.xcconfig"
